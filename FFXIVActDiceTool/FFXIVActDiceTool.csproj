<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>FFXIVActDiceTool</AssemblyName>
    <RootNamespace>FFXIVActDiceTool</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <ACTPath Condition="'$(ACTPath)' == '' and '$(ACT_PATH)' != ''">$(ACT_PATH)</ACTPath>
    <ACTReference Condition="'$(ACTPath)' != ''">$(ACTPath)\Advanced Combat Tracker.exe</ACTReference>
    <ACTReference Condition="'$(ACTReference)' == '' and Exists('$(MSBuildProjectDirectory)\..\lib\Advanced Combat Tracker.exe')">$(MSBuildProjectDirectory)\..\lib\Advanced Combat Tracker.exe</ACTReference>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Advanced Combat Tracker" Condition="Exists('$(ACTReference)')">
      <HintPath>$(ACTReference)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <Target Name="ValidateACTReference" BeforeTargets="ResolveReferences" Condition="!Exists('$(ACTReference)')">
    <Error Text="Advanced Combat Tracker.exe를 찾을 수 없습니다. /p:ACTPath=&quot;C:\path\to\ACT&quot; 또는 ACT_PATH를 지정하세요." />
  </Target>
</Project>
